---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Generated from the pages themselves: every .html page that is indexable
  (no robots noindex, no sitemap: false) is listed. lastmod is the page's own
  last_modified_at, the same date shown on the page and in its schema, and is
  left out rather than guessed when a page has none.
{%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign cg_pages = site.pages | sort: "url" -%}
{%- for p in cg_pages -%}
  {%- unless p.url contains '.html' or p.url == '/' -%}{%- continue -%}{%- endunless -%}
  {%- if p.robots contains 'noindex' or p.sitemap == false -%}{%- continue -%}{%- endif -%}
  {%- assign cg_loc = p.url | replace: '/index.html', '/' | replace: '.html', '' %}
  <url>
    <loc>{{ site.url }}{{ cg_loc }}</loc>
    {%- if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date: '%Y-%m-%d' }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
